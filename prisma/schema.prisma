// ─────────────────────────────────────────────────────────────────────────
// Capacity Planning — multi-tenant Postgres schema (Supabase)
//
// Every table that holds workspace-scoped data carries a non-null
// `workspaceId` foreign key with ON DELETE CASCADE. Row-Level Security
// policies (set at the database level outside this schema) enforce that
// a Postgres role can only see rows for workspaces it's a member of.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ──────────────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  // Brand accent colour — used wherever the app would otherwise use the
  // default coral. Hex string, e.g. "#E31837" for York University red.
  accentColor String   @default("#ff6a4d")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships      Membership[]
  sprints          Sprint[]
  teamMembers      TeamMember[]
  stories          Story[]
  publicHolidays   PublicHoliday[]
  projectHolidays  ProjectHoliday[]
  ptoEntries       PtoEntry[]
  initialCapacities InitialCapacity[]
  guideEntries     GuideEntry[]
  sprintStories    SprintStory[]
  phases           Phase[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  // Supabase auth user id — kept as UUID, no FK because auth.users lives in
  // a separate schema. We trust the auth layer.
  userId      String   @db.Uuid
  workspaceId String   @db.Uuid
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

// ─── Project data — every model is workspace-scoped ───────────────────────

model Sprint {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String
  startDate       String?
  endDate         String?
  durationWeeks   Int      @default(4)
  workingDays     Int      @default(20)
  focusFactor     Float    @default(0.9)
  velocityProven  Float?
  velocityTarget  Float?
  isCurrent       Boolean  @default(false)
  isDemo          Boolean  @default(false)
  progressFactor  Float    @default(0)
  storyCount      Int?
  storyPoints     Float?
  commitmentSP    Float?
  completedSP     Float?
  phaseId         String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phase         Phase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  sprintStories SprintStory[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  lastName     String
  firstName    String
  role         String
  location     String   @default("")
  stream       String
  ftPt         String   @default("FT")
  hrsPerWeek   Float
  allocation   Float    @default(1.0)
  pod          String?
  sheetRow     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Story — Jira issues. Key is unique per workspace (same Jira project key
// can exist in two workspaces if two clients share a numbering scheme).
model Story {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  key         String
  summary     String
  status      String
  storyPoints Float?
  pod         String?
  dependency  String?
  stream      String
  sheetRow    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model PublicHoliday {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  date        String
  name        String
  country     String
  sprint      String?
  days        Float   @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ProjectHoliday {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  date        String
  name        String
  sprint      String?
  days        Float   @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model PtoEntry {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  who         String
  location    String  @default("")
  team        String?
  startDate   String
  endDate     String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model InitialCapacity {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @db.Uuid
  lastName     String
  firstName    String
  role         String
  location     String  @default("")
  organization String  @default("")
  stream       String  @default("")
  ftPt         String  @default("FT")
  hrsPerWeek   Float
  isActive     Boolean @default(true)
  refinement   Float   @default(0)
  design       Float   @default(0)
  development  Float   @default(0)
  qa           Float   @default(0)
  kt           Float   @default(0)
  lead         Float   @default(0)
  pmo          Float   @default(0)
  retrofits    Float   @default(0)
  ocmComms     Float   @default(0)
  ocmTraining  Float   @default(0)
  other        Float   @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model GuideEntry {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @db.Uuid
  section     String
  term        String
  defaultVal  String?
  description String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model SprintStory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  sprintId    String   @db.Uuid
  key         String
  summary     String
  status      String
  storyPoints Float?
  pod         String?
  dependency  String?
  stream      String
  groupName   String?
  importedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, key])
  @@index([workspaceId])
  @@index([sprintId])
}

model Phase {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  name         String
  displayOrder Int
  color        String   @default("#E31837")
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprints   Sprint[]

  @@index([workspaceId])
}
